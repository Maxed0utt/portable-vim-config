snippet snippets "outputs all snippets for this language" b
defmod
def
defp
defstruct
do
if
case
cond
pipe
fn
for
with
genserver
supervisor
test
describe
doc
moduledoc
spec
guard
receive
IO.inspect
dbg
endsnippet

snippet defmod "defmodule ... do ... end" b
defmodule ${1:ModuleName} do
  $0
end
endsnippet

snippet def "def ... do ... end" b
def ${1:function_name}(${2:args}) do
  $0
end
endsnippet

snippet defp "defp ... do ... end" b
defp ${1:function_name}(${2:args}) do
  $0
end
endsnippet

snippet defstruct "defstruct" b
defstruct [${1::field1, :field2}]
endsnippet

snippet do "do block" b
do
  $0
end
endsnippet

snippet if "if ... do ... end" b
if ${1:condition} do
  $0
end
endsnippet

snippet case "case ... do ... end" b
case ${1:expression} do
  ${2:pattern} ->
    $0
end
endsnippet

snippet cond "cond do ... end" b
cond do
  ${1:condition} ->
    $0
end
endsnippet

snippet pipe "pipe operator" b
|> ${1:function}($0)
endsnippet

snippet fn "anonymous function" w
fn ${1:args} -> ${0:body} end
endsnippet

snippet for "for comprehension" b
for ${1:item} <- ${2:enumerable} do
  $0
end
endsnippet

snippet with "with ... do ... end" b
with ${1:{:ok, result\}} <- ${2:expression} do
  $0
else
  ${3:error} -> ${4:handle_error}
end
endsnippet

snippet genserver "GenServer boilerplate" b
defmodule ${1:ModuleName} do
  use GenServer

  # Client API

  def start_link(opts \\\\ []) do
    GenServer.start_link(__MODULE__, opts, name: __MODULE__)
  end

  # Server Callbacks

  @impl true
  def init(state) do
    {:ok, state}
  end

  @impl true
  def handle_call(${2:msg}, _from, state) do
    {:reply, state, state}
  end

  @impl true
  def handle_cast(${3:msg}, state) do
    {:noreply, state}
  end
end
endsnippet

snippet supervisor "Supervisor boilerplate" b
defmodule ${1:ModuleName}.Supervisor do
  use Supervisor

  def start_link(opts \\\\ []) do
    Supervisor.start_link(__MODULE__, opts, name: __MODULE__)
  end

  @impl true
  def init(_opts) do
    children = [
      $0
    ]

    Supervisor.init(children, strategy: :one_for_one)
  end
end
endsnippet

snippet test "test block" b
test "${1:description}" do
  $0
end
endsnippet

snippet describe "describe block" b
describe "${1:context}" do
  $0
end
endsnippet

snippet doc "function documentation" b
@doc """
${1:Documentation}
"""
endsnippet

snippet moduledoc "module documentation" b
@moduledoc """
${1:Module documentation}
"""
endsnippet

snippet spec "typespec" b
@spec ${1:function_name}(${2:arg_types}) :: ${3:return_type}
endsnippet

snippet guard "guard clause function" b
def ${1:function_name}(${2:args}) when ${3:guard} do
  $0
end
endsnippet

snippet receive "receive block" b
receive do
  ${1:pattern} ->
    $0
after
  ${2:5000} -> :timeout
end
endsnippet

snippet IO.inspect "IO.inspect with label" w
IO.inspect(${1:value}, label: "${2:label}")
endsnippet

snippet dbg "dbg" w
dbg(${1:value})
endsnippet
